<Project Sdk="Microsoft.NET.Sdk">
  <!--
    TastaturTrainer – Desktop-App (eine einzige EXE)
    - .NET Framework 4.8 (in Windows 10/11 enthalten) + WebView2 (Edge-Engine, in Windows 10/11 enthalten)
    - Web-App (index.html, css, js, icons) und die WebView2-Bibliotheken sind als Ressourcen eingebettet
    - keine Admin-Rechte nötig (asInvoker), kein Webserver, kein offener Port
    Bauen: node tools/build-exe.js
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TastaturTrainer</AssemblyName>
    <RootNamespace>TastaturTrainer</RootNamespace>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>TastaturTrainer</Product>
    <Company>smolo-de</Company>
    <Copyright>MIT License – provided as is, without warranty</Copyright>
    <Description>TastaturTrainer – Blindschreiben lernen / touch typing trainer</Description>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
    <!-- Referenz-Assemblies für .NET Framework 4.8: Build unabhängig von installierten Targeting Packs -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Web-App einbetten (gleiche Dateien wie GitHub Pages / HTML-Version) -->
  <ItemGroup>
    <EmbeddedResource Include="..\index.html;..\icon.ico" LogicalName="web/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\css\**\*.css" LogicalName="web/css/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\js\**\*.js" LogicalName="web/js/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\icons\*.png" LogicalName="web/icons/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- WebView2-Bibliotheken einbetten, damit nur eine EXE weitergegeben werden muss -->
  <ItemGroup Condition="'$(PkgMicrosoft_Web_WebView2)' != ''">
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="lib/Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="lib/Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="lib/WebView2Loader.dll" />
  </ItemGroup>
</Project>
